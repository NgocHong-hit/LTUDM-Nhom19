<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="700.0" prefWidth="960.0" spacing="20.0" styleClass="exam-root" stylesheets="@../css/exam.css" xmlns="http://javafx.com/javafx/17.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Client_GUI.Controller.ExamResult">
   <padding>
      <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
   </padding>
   <children>
      <!-- Khung tổng hợp kết quả cá nhân -->
      <VBox alignment="CENTER" spacing="8.0" styleClass="content-box">
         <children>
            <Label styleClass="page-title" text="KẾT QUẢ THI TRẮC NGHIỆM" />
            <Label fx:id="lblScore" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #2563eb;" text="0.00 / 10.0" />
            <Label fx:id="lblTimeInfo" style="-fx-font-size: 14px; -fx-text-fill: #64748b;" text="Thời gian làm bài: 0 giây" />
         </children>
         <padding>
            <Insets bottom="16.0" top="16.0" />
         </padding>
      </VBox>

      <!-- Bảng Xếp Hạng Bộ Đề Thi -->
      <VBox spacing="10.0" VBox.vgrow="ALWAYS">
         <children>
            <Label styleClass="page-title" style="-fx-font-size: 18px;" text="🏆 BẢNG XẾP HẠNG BỘ ĐỀ THI" />
            <TableView fx:id="tblLeaderboard" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colRank" prefWidth="80.0" text="Hạng" />
                  <TableColumn fx:id="colUser" prefWidth="320.0" text="Thí sinh" />
                  <TableColumn fx:id="colScore" prefWidth="160.0" text="Điểm số" />
                  <TableColumn fx:id="colTime" prefWidth="180.0" text="Thời gian (Giây)" />
                  <TableColumn fx:id="colSubmittedAt" prefWidth="180.0" text="Ngày nộp" />
               </columns>
            </TableView>
         </children>
      </VBox>

      <!-- Nút thao tác -->
      <HBox alignment="CENTER_RIGHT" spacing="12.0">
         <children>
            <Button onAction="#handleReturnHome" styleClass="btn-primary-blue" text="Quay lại trang chủ" />
         </children>
      </HBox>
   </children>
</VBox>