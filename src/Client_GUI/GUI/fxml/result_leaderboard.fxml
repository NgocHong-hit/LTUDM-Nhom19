<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="750.0" prefWidth="1000.0" spacing="16.0" styleClass="result-root" stylesheets="@../css/result_leaderboard.css" xmlns="http://javafx.com/javafx/17.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Client_GUI.Controller.Result">
    <children>
        <!-- 1. Thanh Header tiêu đề -->
        <HBox alignment="CENTER_LEFT" styleClass="header-bar">
            <children>
                <VBox spacing="1.0">
                    <children>
                        <Label fx:id="lblQuizTitle" styleClass="title-text" text="Kết quả bài thi &amp; Bảng xếp hạng" />
                        <Label style="-fx-font-size: 12px; -fx-text-fill: #64748b;" text="Thống kê kết quả làm bài cá nhân và xếp hạng chung" />
                    </children>
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <HBox spacing="10.0">
                    <children>
                        <Button fx:id="btnReview" onAction="#handleReviewAnswers" styleClass="btn-outline" text="Xem lại đáp án" />
                        <Button fx:id="btnBackHome" onAction="#handleBackHome" styleClass="btn-primary-blue" text="Về trang chủ" />
                    </children>
                </HBox>
            </children>
        </HBox>

        <!-- 2. Nội dung chính: Kết quả cá nhân và Bảng xếp hạng -->
        <VBox spacing="16.0" VBox.vgrow="ALWAYS">
            <padding>
                <Insets bottom="20.0" left="24.0" right="24.0" />
            </padding>
            <children>
                <!-- Thẻ tóm tắt kết quả cá nhân -->
                <HBox spacing="14.0" styleClass="summary-card">
                    <children>
                        <!-- Hộp điểm số -->
                        <VBox prefWidth="180.0" styleClass="score-box">
                            <children>
                                <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #16a34a;" text="ĐIỂM SỐ ĐẠT ĐƯỢC" />
                                <Label fx:id="lblScore" styleClass="score-value" text="0.00" />
                                <Label style="-fx-font-size: 11px; -fx-text-fill: #64748b;" text="Thang điểm 10.00" />
                            </children>
                        </VBox>

                        <!-- Các thẻ chi tiết -->
                        <HBox spacing="12.0" HBox.hgrow="ALWAYS">
                            <children>
                                <VBox styleClass="stat-item" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label styleClass="stat-title" text="Số câu trả lời đúng" />
                                        <Label fx:id="lblCorrectCount" styleClass="stat-data" text="0 / 0 câu" />
                                    </children>
                                </VBox>
                                <VBox styleClass="stat-item" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label styleClass="stat-title" text="Thời gian làm bài" />
                                        <Label fx:id="lblTimeCompleted" styleClass="stat-data" text="0 giây" />
                                    </children>
                                </VBox>
                                <VBox styleClass="stat-item" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label styleClass="stat-title" text="Xếp hạng của bạn" />
                                        <Label fx:id="lblUserRank" styleClass="stat-data" text="-" />
                                    </children>
                                </VBox>
                            </children>
                        </HBox>
                    </children>
                </HBox>

                <!-- Bảng xếp hạng thành tích -->
                <VBox spacing="12.0" styleClass="leaderboard-panel" VBox.vgrow="ALWAYS">
                    <children>
                        <HBox alignment="CENTER_LEFT">
                            <children>
                                <VBox spacing="2.0">
                                    <children>
                                        <Label styleClass="section-title" text="Bảng xếp hạng thành tích" />
                                        <Label style="-fx-font-size: 12px; -fx-text-fill: #64748b;" text="Ưu tiên: Điểm cao nhất ➔ Thời gian làm bài ngắn nhất" />
                                    </children>
                                </VBox>
                                <Region HBox.hgrow="ALWAYS" />
                                <Label fx:id="lblTotalParticipants" style="-fx-font-size: 12.5px; -fx-font-weight: 500; -fx-text-fill: #64748b;" text="Tổng số lượt thi: 0" />
                            </children>
                        </HBox>

                        <TableView fx:id="tblLeaderboard" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colRank" maxWidth="95.0" minWidth="70.0" prefWidth="80.0" text="Thứ hạng" />
                                <TableColumn fx:id="colCandidateName" minWidth="180.0" prefWidth="220.0" text="Họ và tên thí sinh" />
                                <TableColumn fx:id="colEmail" minWidth="190.0" prefWidth="230.0" text="Tài khoản email" />
                                <TableColumn fx:id="colScore" maxWidth="120.0" minWidth="90.0" prefWidth="100.0" text="Điểm số" />
                                <TableColumn fx:id="colDuration" maxWidth="160.0" minWidth="120.0" prefWidth="135.0" text="Thời gian thi" />
                                <TableColumn fx:id="colSubmittedAt" minWidth="160.0" prefWidth="180.0" text="Thời điểm nộp" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</VBox>