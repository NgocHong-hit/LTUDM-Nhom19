<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="750.0" prefWidth="1000.0" spacing="16.0" styleClass="main-bg" stylesheets="@../css/home.css" xmlns="http://javafx.com/javafx/17.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Client_GUI.Controller.MainDashboard">
    <children>
        <!-- 1. Thanh Header trên cùng -->
        <HBox alignment="CENTER_LEFT" styleClass="header-bar">
            <children>
                <VBox spacing="1.0">
                    <children>
                        <Label styleClass="brand-title" text="EduQuiz" />
                        <Label styleClass="brand-sub" text="Hệ thống thi trắc nghiệm trực tuyến" />
                    </children>
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <HBox alignment="CENTER" spacing="10.0">
                    <children>
                        <Button fx:id="btnCreateQuiz" onAction="#goToCreateQuiz" styleClass="btn-create" text="+ Tạo bộ đề mới" />
                        <Button fx:id="btnUser" onAction="#openProfile" styleClass="btn-user-profile" text="Thí sinh" />
                        <Button fx:id="btnLogout" onAction="#handleLogout" styleClass="btn-logout" text="Đăng xuất" />
                    </children>
                </HBox>
            </children>
        </HBox>

        <!-- Khung nội dung chính -->
        <VBox spacing="16.0" VBox.vgrow="ALWAYS">
            <padding>
                <Insets bottom="20.0" left="24.0" right="24.0" />
            </padding>
            <children>
                <!-- 2. Thẻ Thống kê nhanh -->
                <HBox spacing="14.0">
                    <children>
                        <VBox prefWidth="250.0" styleClass="stat-card" HBox.hgrow="ALWAYS">
                            <children>
                                <Label styleClass="stat-label" text="Tổng số bộ đề có sẵn" />
                                <Label fx:id="lblTotalQuizzes" styleClass="stat-number" text="0" />
                            </children>
                        </VBox>
                        <VBox prefWidth="250.0" styleClass="stat-card" HBox.hgrow="ALWAYS">
                            <children>
                                <Label styleClass="stat-label" text="Số bài thi bạn đã hoàn thành" />
                                <Label fx:id="lblUserCompletedExams" styleClass="stat-number" text="0" />
                            </children>
                        </VBox>
                        <VBox prefWidth="250.0" styleClass="stat-card" HBox.hgrow="ALWAYS">
                            <children>
                                <Label styleClass="stat-label" text="Điểm trung bình của bạn" />
                                <Label fx:id="lblAvgScore" style="-fx-text-fill: #16a34a;" styleClass="stat-number" text="0.00 / 10" />
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <!-- 3. Khu vực Bảng danh sách bộ đề -->
                <VBox spacing="12.0" styleClass="content-box" VBox.vgrow="ALWAYS">
                    <children>
                        <!-- Thanh công cụ tìm kiếm và làm mới -->
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <VBox spacing="2.0">
                                    <children>
                                        <Label styleClass="section-title" text="Ngân hàng đề thi" />
                                        <Label styleClass="section-subtitle" text="Chọn bộ đề để tham gia thi hoặc chỉnh sửa đề bạn đã tạo" />
                                    </children>
                                </VBox>
                                <Region HBox.hgrow="ALWAYS" />
                                <TextField fx:id="txtSearch" prefWidth="240.0" promptText="Tìm kiếm tên bộ đề..." styleClass="search-input" />
                                <Button fx:id="btnRefresh" onAction="#handleRefresh" styleClass="btn-refresh" text="Làm mới" />
                            </children>
                        </HBox>

                        <!-- TableView hiển thị các cột -->
                        <TableView fx:id="tblQuizzes" prefHeight="380.0" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colId" maxWidth="65.0" minWidth="45.0" prefWidth="55.0" style="-fx-alignment: CENTER;" text="Mã" />
                                <TableColumn fx:id="colTitle" minWidth="120.0" prefWidth="160.0" style="-fx-alignment: CENTER-LEFT;" text="Tên bộ đề" />
                                <TableColumn fx:id="colCreator" minWidth="125.0" prefWidth="155.0" style="-fx-alignment: CENTER-LEFT;" text="Người tạo" />
                                <TableColumn fx:id="colDuration" minWidth="75.0" prefWidth="90.0" style="-fx-alignment: CENTER;" text="Thời gian" />
                                <TableColumn fx:id="colTotalQuestions" minWidth="55.0" prefWidth="65.0" style="-fx-alignment: CENTER;" text="Số câu" />
                                <TableColumn fx:id="colAttemptCount" minWidth="55.0" prefWidth="65.0" style="-fx-alignment: CENTER;" text="Lượt thi" />
                                <TableColumn fx:id="colAvgScore" minWidth="60.0" prefWidth="70.0" style="-fx-alignment: CENTER;" text="Điểm TB" />
                                <TableColumn fx:id="colMaxScore" minWidth="60.0" prefWidth="70.0" style="-fx-alignment: CENTER;" text="Điểm cao" />
                                <TableColumn fx:id="colAction" minWidth="135.0" prefWidth="150.0" style="-fx-alignment: CENTER;" text="Thao tác" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</VBox>
