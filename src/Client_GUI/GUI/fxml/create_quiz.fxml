<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="760.0" prefWidth="1050.0" spacing="12.0" styleClass="app-root" stylesheets="@../css/create_quiz.css" xmlns="http://javafx.com/javafx/17.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Client_GUI.Controller.ExamManagement">
    <children>
        <!-- Thanh điều hướng trên cùng -->
        <HBox alignment="CENTER_LEFT" styleClass="top-bar">
            <children>
                <VBox spacing="1.0">
                    <children>
                        <Label fx:id="lblFormTitle" styleClass="page-title" text="Soạn thảo bộ đề thi" />
                    </children>
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <Button onAction="#handleBack" styleClass="btn-outline" text="Quay lại trang chủ" />
            </children>
        </HBox>

        <!-- Khung làm việc 2 cột -->
        <HBox spacing="16.0" VBox.vgrow="ALWAYS">
            <padding>
                <Insets bottom="16.0" left="20.0" right="20.0" />
            </padding>
            <children>
                <!-- Cột trái: Thiết lập chung & Form soạn câu hỏi -->
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="clean-scroll" HBox.hgrow="ALWAYS">
                    <content>
                        <VBox spacing="14.0">
                            <!-- Khối 1: Thông tin đề thi -->
                            <VBox spacing="10.0" styleClass="content-box">
                                <children>
                                    <Label styleClass="box-header" text="Thông tin chung về bộ đề" />

                                    <VBox spacing="4.0">
                                        <children>
                                            <Label styleClass="field-label" text="Tên bộ đề:" />
                                            <TextField fx:id="txtQuizTitle" promptText="Ví dụ: Kiểm tra Kiến thức Lập trình Java Cơ bản" styleClass="input-flat" />
                                        </children>
                                    </VBox>

                                    <HBox spacing="12.0">
                                        <children>
                                            <VBox prefWidth="170.0" spacing="4.0">
                                                <children>
                                                    <Label styleClass="field-label" text="Thời gian làm bài:" />
                                                    <Spinner fx:id="spnDuration" editable="true" maxWidth="Infinity" styleClass="input-flat" />
                                                </children>
                                            </VBox>
                                            <VBox prefWidth="210.0" spacing="4.0">
                                                <children>
                                                    <Label styleClass="field-label" text="Gợi ý số câu hỏi:" />
                                                    <ComboBox fx:id="cmbSuggestedQuestions" maxWidth="Infinity" styleClass="input-flat" />
                                                </children>
                                            </VBox>
                                            <VBox alignment="CENTER_LEFT" spacing="4.0" HBox.hgrow="ALWAYS">
                                                <children>
                                                    <Label styleClass="field-label" text="Quy chế &amp; tiến độ điểm:" />
                                                    <Label fx:id="lblScoreInfo" styleClass="note-chip" text="Tổng 10 điểm" />
                                                </children>
                                            </VBox>
                                        </children>
                                    </HBox>

                                    <VBox spacing="4.0">
                                        <children>
                                            <Label styleClass="field-label" text="Mô tả / Ghi chú cho thí sinh:" />
                                            <TextArea fx:id="txtQuizDescription" prefRowCount="2" promptText="Ghi chú ngắn gọn cho thí sinh..." styleClass="input-flat" wrapText="true" />
                                        </children>
                                    </VBox>
                                </children>
                            </VBox>

                            <!-- Khối 2: Nhập nội dung câu hỏi -->
                            <VBox spacing="12.0" styleClass="content-box">
                                <children>
                                    <HBox alignment="CENTER_LEFT">
                                        <children>
                                            <Label fx:id="lblQuestionIndex" styleClass="box-header" text="Soạn nội dung câu hỏi" />
                                            <Region HBox.hgrow="ALWAYS" />
                                            <Label styleClass="sub-tip" text="* Tích chọn đáp án đúng duy nhất" />
                                        </children>
                                    </HBox>

                                    <VBox spacing="4.0">
                                        <children>
                                            <Label styleClass="field-label" text="Đề bài câu hỏi:" />
                                            <TextArea fx:id="txtQuestionContent" prefRowCount="3" promptText="Nhập đề bài hoặc câu hỏi..." styleClass="input-flat" wrapText="true" />
                                        </children>
                                    </VBox>

                                    <VBox spacing="4.0">
                                        <children>
                                            <Label styleClass="field-label" text="Ảnh minh họa đính kèm (không bắt buộc):" />
                                            <HBox spacing="8.0">
                                                <children>
                                                    <TextField fx:id="txtImageUrl" promptText="Đường dẫn file ảnh minh họa..." styleClass="input-flat" HBox.hgrow="ALWAYS" />
                                                    <Button onAction="#handleBrowseImage" styleClass="btn-outline" text="Chọn tệp..." />
                                                </children>
                                            </HBox>
                                        </children>
                                    </VBox>

                                    <!-- 4 phương án -->
                                    <VBox spacing="6.0">
                                        <children>
                                            <Label styleClass="field-label" text="4 Phương án trả lời:" />

                                            <fx:define>
                                                <ToggleGroup fx:id="correctAnswerGroup" />
                                            </fx:define>

                                            <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="opt-row">
                                                <children>
                                                    <RadioButton fx:id="rbOptionA" prefWidth="40.0" selected="true" text="A" toggleGroup="$correctAnswerGroup" />
                                                    <TextField fx:id="txtOptionA" promptText="Nội dung đáp án A" styleClass="input-flat" HBox.hgrow="ALWAYS" />
                                                </children>
                                            </HBox>

                                            <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="opt-row">
                                                <children>
                                                    <RadioButton fx:id="rbOptionB" prefWidth="40.0" text="B" toggleGroup="$correctAnswerGroup" />
                                                    <TextField fx:id="txtOptionB" promptText="Nội dung đáp án B" styleClass="input-flat" HBox.hgrow="ALWAYS" />
                                                </children>
                                            </HBox>

                                            <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="opt-row">
                                                <children>
                                                    <RadioButton fx:id="rbOptionC" prefWidth="40.0" text="C" toggleGroup="$correctAnswerGroup" />
                                                    <TextField fx:id="txtOptionC" promptText="Nội dung đáp án C" styleClass="input-flat" HBox.hgrow="ALWAYS" />
                                                </children>
                                            </HBox>

                                            <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="opt-row">
                                                <children>
                                                    <RadioButton fx:id="rbOptionD" prefWidth="40.0" text="D" toggleGroup="$correctAnswerGroup" />
                                                    <TextField fx:id="txtOptionD" promptText="Nội dung đáp án D" styleClass="input-flat" HBox.hgrow="ALWAYS" />
                                                </children>
                                            </HBox>
                                        </children>
                                    </VBox>

                                    <HBox alignment="CENTER_RIGHT" spacing="10.0">
                                        <children>
                                            <Button onAction="#handleClearQuestionForm" styleClass="btn-outline" text="Làm sạch ô" />
                                            <Button fx:id="btnAddQuestion" onAction="#handleAddQuestion" styleClass="btn-secondary-blue" text="+ Thêm câu hỏi" />
                                        </children>
                                    </HBox>
                                </children>
                            </VBox>
                        </VBox>
                    </content>
                </ScrollPane>

                <!-- Cột phải: Danh sách tóm tắt & Lưu bộ đề -->
                <VBox prefWidth="350.0" spacing="12.0" styleClass="content-box">
                    <children>
                        <HBox alignment="CENTER_LEFT">
                            <children>
                                <Label styleClass="box-header" text="Danh sách câu hỏi" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label fx:id="lblQuestionCount" styleClass="badge-count" text="(0 câu)" />
                            </children>
                        </HBox>

                        <ListView fx:id="listQuestions" styleClass="simple-list" VBox.vgrow="ALWAYS" />

                        <HBox spacing="8.0">
                            <children>
                                <Button maxWidth="Infinity" onAction="#handleEditSelected" styleClass="btn-outline" text="Chỉnh sửa" HBox.hgrow="ALWAYS" />
                                <Button maxWidth="Infinity" onAction="#handleDeleteSelected" styleClass="btn-danger-outline" text="Xóa câu" HBox.hgrow="ALWAYS" />
                            </children>
                        </HBox>

                        <Label fx:id="lblStatus" minHeight="18.0" wrapText="true" />

                        <Button fx:id="btnSaveQuiz" maxWidth="Infinity" onAction="#handleSaveQuiz" prefHeight="40.0" styleClass="btn-primary-blue" text="Lưu bộ đề thi" />
                    </children>
                </VBox>
            </children>
        </HBox>
    </children>
</VBox>